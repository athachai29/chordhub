# Used on server side only.
NUXT_DB_URL=

NEXTAUTH_URL=
# Full auth URL including /api/auth (nuxt-auth >= 0.6), e.g. https://chordhub.app/api/auth
AUTH_ORIGIN=
NUXT_AUTH_SECRET=
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_FACEBOOK_CLIENT_ID=
NUXT_FACEBOOK_CLIENT_SECRET=

# Anti-scraping guard for /api/songs*. MODE is off|log|enforce (default log).
NUXT_SCRAPER_GUARD_MODE=log
NUXT_SCRAPER_GUARD_PER_MINUTE=30
NUXT_SCRAPER_GUARD_PER_DAY=500
# Max POST /api/auth/register per IP (IPv6: per /64) per day.
NUXT_SCRAPER_GUARD_REGISTER_PER_DAY=5
# Header carrying the real client IP (e.g. cf-connecting-ip). Empty = use X-Forwarded-For.
NUXT_SCRAPER_GUARD_IP_HEADER=
# Trusted proxies after the client in X-Forwarded-For (0 = rightmost entry).
NUXT_SCRAPER_GUARD_XFF_HOPS_FROM_RIGHT=0

# Auto-detected by nuxt-gtag module. Not have to set manually.
NUXT_PUBLIC_GTAG_ID=

# Add 'NUXT_PUBLIC_' prefix to make it available in client side.
NUXT_PUBLIC_BUY_ME_A_COFFEE_URL=
NUXT_PUBLIC_DICEBEAR_API_URL=

# Used for SEO.
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_SITE_DESCRIPTION=
NUXT_PUBLIC_SITE_SOCIAL_NETWORK_DESCRIPTION=